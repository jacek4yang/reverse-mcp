# Repository-wide encoding & whitespace policy (encoding incident hardening).
# Every tracked text file is UTF-8 without BOM, LF line endings.
# Enforced additionally by the CI mojibake guard (.github/workflows/ci.yml)
# and by `scripts/check-encoding.py`.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{rs,c,h,hpp,cpp,cc}]
indent_size = 4

[*.{yml,yaml,json,toml,editorconfig}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
